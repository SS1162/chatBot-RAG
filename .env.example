# Required
GROQ_API_KEY=
HF_API_KEY=

# .NET backend that serves /api/products/all
DOTNET_BASE_URL=https://localhost:44359
# Set to false ONLY for a local self-signed .NET dev certificate
DOTNET_VERIFY_SSL=true

# Public site URL (used for links in the bot's answers) and allowed CORS origins (comma separated)
SITE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000

# Optional tuning
# HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
# LLM_MODEL=llama-3.3-70b-versatile
# PRODUCTS_REFRESH_SECONDS=600
# EMBED_CACHE_MAX=2000
# MAX_TOOL_ROUNDS=3
# TOP_K=5
